# Copy to .env and fill in only what you use. The API server reads it at start; real env vars win. Never commit .env. Placeholders only.

# --- optional LLM explanations (deterministic analysis works without these) ---
SHIELD_LLM_PROVIDER=none            # none | groq | anthropic
SHIELD_LLM_MODEL=                   # blank = provider default
GROQ_API_KEY=                       # e.g. gsk_... (development)
ANTHROPIC_API_KEY=                  # e.g. sk-ant-... (production)
SHIELD_LLM_ENDPOINT=                # https:// override; blank = the provider's own endpoint
SHIELD_LLM_TIMEOUT=20
SHIELD_LLM_RETRIES=2
SHIELD_LLM_MAX_WAIT=20              # longest pause, in seconds, when the provider asks the client to slow down

# --- optional discovery search ---
SHIELD_SEARCH_PROVIDER=auto         # auto | brave | google_cse | serper | offline
BRAVE_API_KEY=
GOOGLE_CSE_KEY=
GOOGLE_CSE_CX=
SERPER_API_KEY=

# --- safety / limits ---
SHIELD_LOCAL_ONLY=0                 # 1 = no remote LLM or search calls at all
SHIELD_API_TOKEN=                   # set to require "Authorization: Bearer <token>" on /api; 32+ characters off loopback (openssl rand -hex 32)
SHIELD_PUBLIC_DEMO=0                # 1 = open site with no token: visitors bring their own AI key, server-wide switches are closed
SHIELD_HOST=127.0.0.1
SHIELD_PORT=8000                    # hosts that inject PORT are honoured when this is blank
SHIELD_ALLOWED_HOSTS=               # extra Host names accepted when no token is set, comma separated; localhost names always are
SHIELD_CORS_ORIGINS=http://localhost:5173
SHIELD_WORK_DIR=                    # where job files live; blank = the system temp folder
SHIELD_MAX_REQUEST_MB=50
SHIELD_MAX_PENDING=16               # queued + running jobs before new ones get 429
SHIELD_MAX_IMAGE_PIXELS=40000000
SHIELD_MAX_UPLOAD_MB=25
SHIELD_MAX_PDF_PAGES=200
SHIELD_MAX_TEXT_CHARS=200000
SHIELD_JOB_TTL_SECONDS=3600
SHIELD_MAX_JOBS=2
SHIELD_CRAWL_MAX_PAGES=100
SHIELD_CRAWL_MAX_DEPTH=3              # link steps from a seed page; pages from the site's sitemap count as one step
SHIELD_CRAWL_MAX_IMAGES_PER_PAGE=30  # images checked per ordinary page; the rest are counted as skipped
SHIELD_CRAWL_RPS=1
SHIELD_CRAWL_TIMEOUT=300
SHIELD_REGISTRY=                    # crawl registry file; blank = registry/seeds.yaml (the local demo sites)
SHIELD_USER_AGENT=                  # crawler User-Agent; name a page where site owners can reach you
SHIELD_ALLOW_LOCAL=0                # tests and the local demo only: lets the crawler reach this machine
SHIELD_FACE_REGIONS=1               # detect face regions so photos can be removed (no identification)
SHIELD_PERSONAS=PrivacyHawk,PragmaticDev,StatutoryAuditor,SwarmAdjudicator
SHIELD_PLAYWRIGHT_CHANNEL=             # e.g. chrome, when the bundled Playwright browser is missing
SHIELD_MCP_ROOT=                    # folder MCP tools may open files in; blank = the working directory
SHIELD_PCA_INDEX_DIR=               # images the PCA candidate tool is fitted on; blank = the demo set
